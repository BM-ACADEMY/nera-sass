    {
      "parameters": {
        "url": "https://api.x.ai/v1/chat/completions",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\\n  \"model\":\"grok-3\",\\n  \"messages\":[\\n    {\"role\":\"system\",\"content\":\"Score B2B lead warmth 0-100 from the thread. Return ONLY a number.\"},\\n    {\"role\":\"user\",\"content\":\"Thread summary here\"}\\n  ]\\n}",
