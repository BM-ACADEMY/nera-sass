    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT channel, COUNT(*) FILTER (WHERE status='sent') AS sent,\\n       COUNT(*) FILTER (WHERE status='replied') AS replied\\nFROM alliance_touches\\nWHERE sent_at::date = CURRENT_DATE\\nGROUP BY channel;",
        "options": {}
      },
