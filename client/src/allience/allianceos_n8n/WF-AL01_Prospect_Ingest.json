      "parameters": {
        "jsCode": "// clean each row: trim, lowercase email, normalize phone\\nreturn items.map(i => {\\n  const d = i.json;\\n  d.email = (d.email||'').trim().toLowerCase();\\n  d.phone = (d.phone||'').replace(/[^0-9]/g,'');\\n  if (d.phone && d.phone.length===10) d.phone = '91'+d.phone;\\n  return { json: d };\\n});"
      },
      "id": "9ce257b7-4fbe-45f5-a377-c48cca9085dd",
      "name": "Normalize Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT 1 FROM alliance_suppression\\nWHERE phone = '{{$json.phone}}' OR email = '{{$json.email}}'\\nLIMIT 1;",
        "options": {}
      },
      "id": "996dc712-8335-4b21-9ecc-f209a387f4c9",
