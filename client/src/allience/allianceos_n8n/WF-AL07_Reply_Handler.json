        "specifyBody": "json",
        "jsonBody": "={\\n  \"source\":\"allianceos\",\\n  \"prospect_id\":\"{{$node[\\\"Lookup Prospect\\\"].json.id}}\",\\n  \"reply\":\"{{$node[\\\"Identify Prospect\\\"].json.body}}\",\\n  \"intent\":\"{{$node[\\\"Grok Classify Intent\\\"].json.intent}}\",\\n  \"ai_draft\":\"{{$node[\\\"Grok Draft Reply\\\"].json.choices[0].message.content}}\"\\n}",
        "sendHeaders": true,
        "headerParameters": {
