# Copy to .env and fill in. Never commit .env.
# Nera-specific switches:
#   DISABLED_MODULES=alliance,mafiya,contentos   (set on the shared Nera platform; leave empty on ABM's server)
#   CORS_ORIGINS=https://extra-site.example     (extra browser origins allowed to call the API)
#   META_INVENTORY_SYNC=off                     (do not sync the .env Meta business into the database)
#   MONGODB_URI                                 (use a login limited to this app's own database, never root)
#   NERA_ADMIN_EMAIL / NERA_ADMIN_INITIAL_PASSWORD (used once by scripts/seed-platform-admin.js)
DISABLED_MODULES=
CORS_ORIGINS=
PORT=
NODE_ENV=
PORTAL_URL=
JWT_SECRET=
# How long a sign-in lasts for admin and client (e.g. 7d, 12h). Default 7d.
JWT_EXPIRES_IN=7d
META_CONTENT_OS_APP_ID=
META_CONTENT_OS_APP_SECRET=
META_CONTENT_OS_REDIRECT_URI=
WA_VERIFY_TOKEN=
# App secret of the Meta app the WhatsApp / lead-ads webhooks are subscribed under.
# Every webhook POST is verified against it (X-Hub-Signature-256); unset = webhooks refused (503).
NERA_META_APP_SECRET=
# Legacy single-business settings. Customer messages are always sent with the
# brand's own encrypted credentials; these are no longer read for sends. Leave empty on Nera.
META_PAGE_ACCESS_TOKEN=
WA_BUSINESS_ACCOUNT_ID=
WA_PHONE_NUMBER_ID=
# Internal WhatsApp notifications to the Getnera owner (founder reports, staff
# alerts). Named settings only; unset = not sent, with the reason logged.
NERA_FOUNDER_NOTIFY_PHONE_NUMBER_ID=
NERA_FOUNDER_NOTIFY_ACCESS_TOKEN=
NERA_FOUNDER_NOTIFY_TO=
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_BUSINESS_ID=
OPENAI_API_KEY=
# Razorpay (plans and wallet top-ups, /api/billing). Orders are created and
# signatures verified on the server; the wallet is credited only by the webhook
# (POST /webhook/razorpay/billing, signed with RAZORPAY_WEBHOOK_SECRET).
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
# Signing secret of the Razorpay webhook. Unset = every /webhook/razorpay request is refused (503).
RAZORPAY_WEBHOOK_SECRET=
# Billing switches. Workspaces without a plan keep their legacy per-tenant AI
# quota; BILLING_REQUIRE_PLAN=true makes a plan mandatory for AI replies.
BILLING_REQUIRE_PLAN=
WALLET_TOPUP_MIN_INR=100
WALLET_TOPUP_MAX_INR=100000
INTERNAL_API_KEY=
N8N_WEBHOOK_URL=
# AI Brain workflow (n8n_workflows/WF1B-ai-brain-reply.json); workspaces use it once their AI Brain is on
N8N_BRAIN_WEBHOOK_URL=
# OpenRouter model for AI Brain replies; empty uses openai/gpt-4o-mini
AI_BRAIN_MODEL=
# AI automation limits (see n8n_workflows/README.txt)
AI_REPLY_DELAY_SECONDS=3
AI_REPLIES_PER_TENANT_HOUR=200
# N2: price of the model in AI_BRAIN_MODEL, USD per million tokens, used to log the
# cost of every AI reply (defaults are gpt-4o-mini: 0.15 in, 0.60 out). Not secrets.
AI_PRICE_INPUT_USD_PER_MTOK=
AI_PRICE_OUTPUT_USD_PER_MTOK=
# N2: approved WhatsApp reminder templates (body: {{1}} name, {{2}} service, {{3}} date and time)
# and how many hours before the visit the reminder goes out. Not secrets.
WA_APPOINTMENT_REMINDER_TEMPLATE=
WA_APPOINTMENT_REMINDER_TEMPLATE_TA=
APPOINTMENT_REMINDER_HOURS=
AI_SENDING_HOURS=9-21
# true: an AI handover also pauses the AI on that chat until a person resumes it
AI_HANDOVER_PAUSES=
AI_FOLLOWUP_TEMPLATE=follow_up
# Shared secret sent to n8n as x-getnera-secret; the n8n Webhook nodes check it (Header Auth)
N8N_WEBHOOK_SECRET=
# Admin panel live n8n status (n8n > Settings > n8n API)
N8N_API_URL=
N8N_API_KEY=
N8N_WORKFLOW_PREFIX=Nera WF
GEMINI_MODELS=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
SERP_API_KEY=
GOOGLE_CLIENT_ID_GSC_I=
GOOGLE_CLIENT_SECRET_GSC_I=
COPYLEAKS_API_KEY=
SERP_RADAR_API_KEY=
GOOGLE_CALLBACK_LOCALSEOBRIDGE=
GOOGLE_CALLBACK_GSCINTEL=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_REDIRECT_URI=
VALUESERP_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_MAPS_API_KEY=
# Outgoing mail (invitations, password resets, two-step codes): Hostinger
#   EMAIL_HOST=smtp.hostinger.com  EMAIL_PORT=465  EMAIL_SECURE=true
#   EMAIL_USER=hello@afraventures.in  EMAIL_FROM="Getnera" <hello@afraventures.in>
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_FROM=
NERA_PRODUCT_NAME=Getnera
API_BASE_URL=
PUBLIC_API_URL=
DISABLE_DRIVE_POLLER=
N8N_NEW_LEAD_WEBHOOK_URL=
N8N_WHATSAPP_INBOUND_WEBHOOK_URL=
N8N_PAYMENT_SUCCESS_WEBHOOK_URL=
FOUNDER_WHATSAPP_PHONE=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
PUBLIC_CONTACT_NUMBER=
SHARED_WABA_NUMBER=
META_WEBHOOK_VERIFY_TOKEN=
GOOGLE_CALENDAR_ID=
ALLIANCE_WA_PHONE_NUMBER_ID=
ALLIANCE_WA_ACCESS_TOKEN=
ALLIANCE_EMAIL_PROVIDER=
ALLIANCE_EMAIL_FROM=
ALLIANCE_EMAIL_FROM_NAME=
ALLIANCE_EMAIL_SMTP_HOST=
ALLIANCE_EMAIL_SMTP_PORT=
ALLIANCE_EMAIL_SMTP_SECURE=
ALLIANCE_EMAIL_SMTP_USER=
ALLIANCE_EMAIL_SMTP_PASSWORD=
ALLIANCE_EMAIL_REPLY_TO=
ALLIANCE_AI_NUDGE_ENABLED=
ALLIANCE_AI_NUDGE_MAX=
ALLIANCE_AI_NUDGE_POLL_SECONDS=
ADMIN_PANEL_URL=
MONGODB_URI=
META_INVENTORY_SYNC=
NERA_ADMIN_EMAIL=
NERA_ADMIN_INITIAL_PASSWORD=

# Admin panel "WhatsApp Chat": the platform's own WhatsApp number (Getnera
# support). Use a system-user token that can message this number only; it
# never leaves the server and has no fallback to any other token.
PLATFORM_WA_PHONE_NUMBER_ID=
PLATFORM_WA_ACCESS_TOKEN=
# Optional: the WABA of that number (otherwise read from the Meta inventory).
PLATFORM_WA_BUSINESS_ACCOUNT_ID=
# Media server (mediaserver/, media.getnera.in). Leave MEDIA_SERVER_URL empty to keep
# chat files in uploads/media (development). Secrets come from: cd mediaserver && npm run keygen
MEDIA_SERVER_URL=
MEDIA_PUBLIC_URL=
MEDIA_SIGNING_SECRET=
MEDIA_INTERNAL_KEY=
MEDIA_URL_TTL_SECONDS=900

# Customer notices (N4). Every notice is also emailed (NERA_SMTP_* above).
# WhatsApp copies go only to numbers opted in at signup, only through an
# approved UTILITY template with two body variables ({{1}} workspace, {{2}}
# summary) that lives in the platform WABA below. Leave empty to send email only.
NERA_ALERT_PHONE_NUMBER_ID=
NERA_ALERT_ACCESS_TOKEN=
NERA_ALERT_WABA_ID=
NERA_ALERT_TEMPLATE_LANG=en
NERA_ALERT_TEMPLATE_TEMPLATE_REJECTED=
NERA_ALERT_TEMPLATE_WALLET_LOW=
NERA_ALERT_TEMPLATE_NUMBER_QUALITY=
NERA_ALERT_TEMPLATE_SETUP_UNFINISHED=
NERA_ALERT_TEMPLATE_PAYMENT_FAILED=
# Hours a new workspace has before unfinished setup is flagged (default 24).
SETUP_ALERT_AFTER_HOURS=
