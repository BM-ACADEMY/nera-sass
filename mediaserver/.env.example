# Copy to .env and fill in (npm run keygen prints fresh values). Never commit .env.
PORT=3700
HOST=127.0.0.1
MEDIA_ROOT=/var/lib/getnera-media

# Every tenant key is derived from this. Losing it = every file unreadable.
# Keep an offline copy (password manager), NOT on the same disk as MEDIA_ROOT backups.
MEDIA_MASTER_KEY=

# Same values go into server/.env
MEDIA_SIGNING_SECRET=
MEDIA_INTERNAL_KEY=

MEDIA_MAX_BYTES=104857600
MEDIA_ALLOWED_ORIGINS=https://app.getnera.in,https://admin.getnera.in
