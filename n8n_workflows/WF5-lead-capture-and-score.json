{
  "name": "Nera WF5 - Lead capture and score",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "nera-lead-capture",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "9c2e9937-9cd3-4ce3-8df7-7f0a541103e4",
