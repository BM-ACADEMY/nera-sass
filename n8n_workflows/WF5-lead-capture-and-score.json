        }
      },
      "webhookId": "6e202625-a07b-4eea-84c3-2b34be789306"
    },
    {
      "parameters": {
        "jsCode": "// Edit these four values once per n8n instance.\nreturn [{ json: {\n  api: 'https://YOUR-API-HOST',\n  llmUrl: 'https://api.openai.com/v1/chat/completions',\n  model: 'gpt-4o-mini',\n  minConfidence: 0.6,\n  welcomeTemplate: 'welcome_message',\n  followUpTemplate: 'follow_up'\n} }];"
      },
      "id": "c05c8652-98b7-491b-8ead-f202206fcb29",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        420
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.api }}/api/internal/context",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-tenant-id",
              "value": "={{ $('Webhook').first().json.body.tenant_id }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "lead_id",
              "value": "={{ $('Webhook').first().json.body.lead_id }}"
            },
            {
              "name": "limit",
              "value": "={{ 20 }}"
            }
          ]
        }
      },
      "id": "3e2a8601-ae43-48da-beee-d3a7776cf6bc",
      "name": "Get context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Nera Internal Key"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst ctx = $('Get context').first().json;\nconst convo = (ctx.messages || []).map(m => (m.direction === 'inbound' ? 'Customer: ' : 'Business: ') + m.content).join('\\n');\nconst rules = ctx.scoring_rules || 'Score 0-100. Higher when the customer states a clear need, a budget and a timeline, asks for price or a visit, or replies quickly.';\nconst instruction = 'Extract the lead from this WhatsApp conversation. ' + rules + ' Return JSON only: {\"name\": string|null, \"need\": string|null, \"budget\": string|null, \"timeline\": string|null, \"score\": number 0 to 100}';\nreturn [{ json: { llmBody: { model: cfg.model, temperature: 0, response_format: { type: 'json_object' },\n  messages: [{ role: 'system', content: instruction }, { role: 'user', content: convo || '(no messages)' }] } } }];"
      },
      "id": "8686e085-725a-419b-8576-47e3540606dd",
      "name": "Build extraction prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.llmUrl }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.llmBody) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "5328d044-1c10-4e60-a7ed-046ab783a615",
      "name": "LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "LLM API Key"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "\nlet out = {};\ntry { out = JSON.parse($json.choices[0].message.content); } catch (e) { return [{ json: { ok: false } }]; }\nlet score = Math.max(0, Math.min(100, Math.round(Number(out.score) || 0)));\nif (out.budget) score = Math.min(100, score + 5);\nif (out.timeline) score = Math.min(100, score + 5);\nconst interest = [out.need, out.budget && ('budget ' + out.budget), out.timeline].filter(Boolean).join(' | ') || null;\nreturn [{ json: { ok: true, score, interest, hot: score >= 70 } }];\n"
      },
      "id": "5977b0b8-f919-4734-a9e2-0cbbeb0310f8",
      "name": "Parse and score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        420
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.ok }}",
              "value2": true
            }
          ]
        }
      },
      "id": "c37e6f84-567d-4456-8912-cecc7d873ef7",
      "name": "Extracted?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.api }}/api/internal/update-lead",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-tenant-id",
              "value": "={{ $('Webhook').first().json.body.tenant_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ lead_id: $('Webhook').first().json.body.lead_id, score: $json.score, interest: $json.interest, status: $json.hot ? 'hot' : null }) }}"
      },
      "id": "667d8d59-d59e-4857-80d5-d21db7ea85b2",
      "name": "Update lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        420
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Nera Internal Key"
        }
      }
    },
    {
