      },
      "webhookId": "7116ecd2-dfb4-4508-b8bd-95b947885c65"
    },
    {
      "parameters": {
        "jsCode": "// Edit these values once per n8n instance.\nreturn [{ json: {\n  api: 'https://api.getnera.in',\n  llmUrl: 'https://api.openai.com/v1/chat/completions',\n  model: 'gpt-4o-mini',\n  minConfidence: 0.6,\n  welcomeTemplate: 'welcome_message',\n  followUpTemplate: 'follow_up'\n} }];"
      },
      "id": "d198163f-342b-4f40-8a01-3f5f08db8855",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        420
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.api }}/api/internal/context",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-tenant-id",
              "value": "={{ $('Webhook').first().json.body.tenant_id }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "lead_id",
              "value": "={{ $('Webhook').first().json.body.lead_id }}"
            },
            {
              "name": "before_message_id",
              "value": "={{ $('Webhook').first().json.body.message_id }}"
            },
            {
              "name": "limit",
              "value": "={{ 10 }}"
            }
          ]
        }
      },
      "id": "12f530b3-438f-46a0-9746-e23260ccaf2e",
      "name": "Get context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Nera Internal Key"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body;\nconst cfg = $('Config').first().json;\nconst ctx = $('Get context').first().json;\n// A person took over this chat (or the customer opted out): stay quiet.\nif (ctx.ai_paused) return [];\n\nconst business = ctx.business_name || 'this business';\nconst brain = (ctx.brain || []).map(b => `[${b.doc_type}] ${b.content}`).join('\\n\\n').slice(0, 12000);\nconst system = [\n  `You are the WhatsApp sales assistant for ${business}.`,\n  `Language: ${ctx.language || 'reply in the language the customer uses'}. Tone: ${ctx.tone || 'friendly, short, professional'}.`,\n  'Answer ONLY from the business knowledge below. If the answer is not there, say the team will confirm and set needs_human to true.',\n  'Never invent prices, offers, dates, links or policies. Never mention any other business.',\n  `Rules:\\n${ctx.rules || '- Keep replies under 80 words.\\n- Ask at most one question at a time.'}`,\n  `Business knowledge:\\n${brain || '(empty)'}`\n].join('\\n\\n');\nconst history = (ctx.messages || []).slice(-10).map(m => ({ role: m.direction === 'inbound' ? 'user' : 'assistant', content: m.content }));\nconst instruction = 'Return JSON only: {\"reply\": string, \"confidence\": number 0 to 1, \"needs_human\": boolean, \"reason\": string, \"lead\": {\"name\": string|null, \"need\": string|null, \"budget\": string|null, \"timeline\": string|null}, \"score\": number 0 to 100}';\nreturn [{ json: { llmBody: { model: cfg.model, temperature: 0.3, response_format: { type: 'json_object' },\n  messages: [{ role: 'system', content: system + '\\n\\n' + instruction }, ...history, { role: 'user', content: body.message }] } } }];"
      },
      "id": "10d7bedb-2cc6-4d9a-a0a2-8aa37fa5aadd",
      "name": "Build prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.llmUrl }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.llmBody) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "788900a7-f14b-456b-94fe-cee1c4a69eb6",
      "name": "LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "LLM API Key"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Config').first().json;\nconst ctx = $('Get context').first().json;\nlet out;\ntry { out = JSON.parse($json.choices[0].message.content); }\ncatch (e) { return [{ json: { route: 'handover', reason: 'AI returned invalid output', draft: '' } }]; }\nconst reply = String(out.reply || '').trim();\nconst problems = [];\nif (!reply) problems.push('empty reply');\nif (reply.length > 1000) problems.push('reply too long');\nif (out.needs_human) problems.push(out.reason || 'AI asked for a person');\nif (!(Number(out.confidence) >= cfg.minConfidence)) problems.push('low confidence');\nconst known = JSON.stringify(ctx).toLowerCase();\nconst badLinks = (reply.match(/https?:\\/\\/\\S+/g) || []).filter(u => !known.includes(u.toLowerCase()));\nif (badLinks.length) problems.push('link not in knowledge');\nconst badNums = (reply.match(/\\+?\\d[\\d\\s-]{8,}\\d/g) || []).filter(n => !known.includes(n.replace(/[\\s-]/g, '')) && !known.includes(n));\nif (badNums.length) problems.push('phone number not in knowledge');\nconst lead = out.lead || {};\nconst score = Math.max(0, Math.min(100, Math.round(Number(out.score) || 0)));\nconst interest = [lead.need, lead.budget && ('budget ' + lead.budget), lead.timeline].filter(Boolean).join(' | ') || null;\nlet route = problems.length ? 'handover' : 'send';\nif (!problems.length && ctx.supervised) { route = 'handover'; problems.push('Supervised mode: approve this draft'); }\nreturn [{ json: { route, reason: problems.join('; '), reply, draft: reply, score, interest, hot: score >= 70 } }];\n"
      },
