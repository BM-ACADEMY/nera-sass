    {
      "parameters": {
        "jsCode": "// Edit these values once per n8n instance.\nreturn [{ json: {\n  api: 'https://api.getnera.in',\n  llmUrl: 'https://openrouter.ai/api/v1/chat/completions',\n  model: 'openai/gpt-4o-mini',\n  minConfidence: 0.6,\n  welcomeTemplate: 'welcome_message',\n  followUpTemplate: 'follow_up'\n} }];"
      },
      "id": "e9372407-6573-4e5c-9e1d-435e560aa7e4",
