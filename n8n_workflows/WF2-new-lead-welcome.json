        720,
        420
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Nera Internal Key"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.api }}/api/internal/handover",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-tenant-id",
              "value": "={{ $('Webhook').first().json.body.tenant_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ lead_id: $('Webhook').first().json.body.lead_id, reason: 'Welcome template could not be sent', mode: 'notify' }) }}"
      },
      "id": "8a17c0de-8beb-4183-9d02-08e435302168",
