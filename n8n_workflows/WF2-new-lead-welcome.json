    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.api }}/api/internal/send-template",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-tenant-id",
              "value": "={{ $('Webhook').first().json.body.tenant_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ lead_id: $('Webhook').first().json.body.lead_id, template: $('Webhook').first().json.body.template || $('Config').first().json.welcomeTemplate, language: $('Webhook').first().json.body.language || 'en', body_params: $('Webhook').first().json.body.body_params || [$('Webhook').first().json.body.name || 'there'] }) }}"
      },
      "id": "6acf7613-ec6e-4ea2-b046-a2b75a0fe330",
      "name": "Send welcome template",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
