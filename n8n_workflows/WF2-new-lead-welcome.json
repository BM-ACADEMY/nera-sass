      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        420
      ]
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": "={{ Number($('Webhook').first().json.body.delay_seconds || 0) }}",
        "unit": "seconds"
      },
      "id": "df795288-67f8-4204-b235-892eff3b6152",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
